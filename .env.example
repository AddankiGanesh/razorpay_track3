# Razorpay Test Mode credentials
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here

# From Razorpay Dashboard -> Webhooks -> your webhook -> Secret
RAZORPAY_WEBHOOK_SECRET=

# App
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Demo customer (used for Lab fires + B2B if email field empty)
DEMO_CUSTOMER_EMAIL=you@gmail.com
DEMO_CUSTOMER_CONTACT=+919876543210

# Resend email (https://resend.com) — leave empty to log-only
RESEND_API_KEY=
RESEND_FROM_EMAIL=RevRecover <onboarding@resend.dev>

# Payment link API throttling
PAYMENT_LINK_MIN_INTERVAL_SEC=3.0
PAYMENT_LINK_REUSE_ON_RATE_LIMIT=false

# Auto-capture authorized payments
AUTO_CAPTURE_ENABLED=true

# Twilio SMS + fallback voice (https://twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ElevenLabs Conversational AI voice agent (https://elevenlabs.io)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=

# LLM — pick one provider (or set LLM_PROVIDER=auto for first available key)
# Gemini: https://aistudio.google.com/api-keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Groq (fast inference) — keys start with gsk_ — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_BASE=https://api.groq.com/openai/v1

# xAI Grok — https://console.x.ai/ (not Groq)
GROK_API_KEY=
# XAI_API_KEY=   # same key, optional alias
GROK_MODEL=grok-3-mini
GROK_API_BASE=https://api.x.ai/v1
LLM_PROVIDER=groq

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1
LLM_DIAGNOSIS_ENABLED=true
LLM_MESSAGES_ENABLED=true
LLM_EXPLANATIONS_ENABLED=true

# ML recovery scoring (offline sklearn — no API key required)
ML_SCORING_ENABLED=true
ML_BLEND_WEIGHT=0.45

# Recovery budget allocator default cap (rupees)
RECOVERY_BUDGET_RUPEES=50000
